      "content": "<conversation_history>\nuser: Make an eight zero eight base.\nuser: Set oscillator 1 to a sine wave (wavetable position 0 on basic shapes) and transpose down 1 octave (-12 semitones) for the deep sub foundation. Set envelope 1 to instant attack (0s), zero sustain (0%), and a long decay around 2-3 seconds for the classic 808 tail that fades out smoothly.\nassistant: Done.\n</conversation_history>\n\n<current_preset>\n{\"author\":\"\",\"comments\":\"\",\"macro1\":\"MACRO 1\",\"macro2\":\"MACRO 2\",\"macro3\":\"MACRO 3\",\"macro4\":\"MACRO 4\",\"preset_name\":\"\",\"preset_style\":\"\",\"settings\":{\"beats_per_minute\":2.0,\"bypass\":0.0,\"chorus_cutoff\":60.0,\"chorus_delay_1\":-9.0,\"chorus_delay_2\":-7.0,\"chorus_dry_wet\":0.5,\"chorus_feedback\":0.4000000059604645,\"chorus_frequency\":-3.0,\"chorus_mod_depth\":0.5,\"chorus_on\":0.0,\"chorus_spread\":1.0,\"chorus_sync\":1.0,\"chorus_tempo\":4.0,\"chorus_voices\":4.0,\"compressor_attack\":0.5,\"compressor_band_gain\":11.699999809265137,\"compressor_band_lower_ratio\":0.800000011920929,\"compressor_band_lower_threshold\":-36.0,\"compressor_band_upper_ratio\":0.8569999933242798,\"compressor_band_upper_threshold\":-25.0,\"compressor_enabled_bands\":0.0,\"compressor_high_gain\":16.299999237060547,\"compressor_high_lower_ratio\":0.800000011920929,\"compressor_high_lower_threshold\":-35.0,\"compressor_high_upper_ratio\":1.0,\"compressor_high_upper_threshold\":-30.0,\"compressor_low_gain\":16.299999237060547,\"compressor_low_lower_ratio\":0.800000011920929,\"compressor_low_lower_threshold\":-35.0,\"compressor_low_upper_ratio\":0.8999999761581421,\"compressor_low_upper_threshold\":-28.0,\"compressor_mix\":1.0,\"compressor_on\":0.0,\"compressor_release\":0.5,\"delay_aux_frequency\":2.0,\"delay_aux_sync\":1.0,\"delay_aux_tempo\":9.0,\"delay_dry_wet\":0.33340001106262207,\"delay_feedback\":0.5,\"delay_filter_cutoff\":60.0,\"delay_filter_spread\":1.0,\"delay_frequency\":2.0,\"delay_on\":0.0,\"delay_style\":0.0,\"delay_sync\":1.0,\"delay_tempo\":9.0,\"distortion_drive\":0.0,\"distortion_filter_blend\":0.0,\"distortion_filter_cutoff\":80.0,\"distortion_filter_order\":0.0,\"distortion_filter_resonance\":0.5,\"distortion_mix\":1.0,\"distortion_on\":0.0,\"distortion_type\":0.0,\"effect_chain_order\":0.0,\"env_1_attack\":0.0,\"env_1_attack_power\":0.0,\"env_1_decay\":1.25,\"env_1_decay_power\":-2.0,\"env_1_delay\":0.0,\"env_1_hold\":0.0,\"env_1_release\":0.5475999712944031,\"env_1_release_power\":-2.0,\"env_1_sustain\":0.0,\"env_2_attack\":0.14949999749660492,\"env_2_attack_power\":0.0,\"env_2_decay\":1.0,\"env_2_decay_power\":-2.0,\"env_2_delay\":0.0,\"env_2_hold\":0.0,\"env_2_release\":0.5475999712944031,\"env_2_release_power\":-2.0,\"env_2_sustain\":1.0,\"env_3_attack\":0.14949999749660492,\"env_3_attack_power\":0.0,\"env_3_decay\":1.0,\"env_3_decay_power\":-2.0,\"env_3_delay\":0.0,\"env_3_hold\":0.0,\"env_3_release\":0.5475999712944031,\"env_3_release_power\":-2.0,\"env_3_sustain\":1.0,\"env_4_attack\":0.14949999749660492,\"env_4_attack_power\":0.0,\"env_4_decay\":1.0,\"env_4_decay_power\":-2.0,\"env_4_delay\":0.0,\"env_4_hold\":0.0,\"env_4_release\":0.5475999712944031,\"env_4_release_power\":-2.0,\"env_4_sustain\":1.0,\"env_5_attack\":0.14949999749660492,\"env_5_attack_power\":0.0,\"env_5_decay\":1.0,\"env_5_decay_power\":-2.0,\"env_5_delay\":0.0,\"env_5_hold\":0.0,\"env_5_release\":0.5475999712944031,\"env_5_release_power\":-2.0,\"env_5_sustain\":1.0,\"env_6_attack\":0.14949999749660492,\"env_6_attack_power\":0.0,\"env_6_decay\":1.0,\"env_6_decay_power\":-2.0,\"env_6_delay\":0.0,\"env_6_hold\":0.0,\"env_6_release\":0.5475999712944031,\"env_6_release_power\":-2.0,\"env_6_sustain\":1.0,\"eq_band_cutoff\":80.0,\"eq_band_gain\":0.0,\"eq_band_mode\":0.0,\"eq_band_resonance\":0.447299987077713,\"eq_high_cutoff\":100.0,\"eq_high_gain\":0.0,\"eq_high_mode\":0.0,\"eq_high_resonance\":0.31630000472068787,\"eq_low_cutoff\":40.0,\"eq_low_gain\":0.0,\"eq_low_mode\":0.0,\"eq_low_reson